<odoo>
    <record id="project_task_ara_community_gantt_view" model="ir.ui.view">
        <field name="name">project.task.community.gantt</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <community_gantt string="Project Gantt">
                <field name="name"/>
                <field name="project_id"/>
                <field name="create_date"/>
                <field name="date_end"/>
                <field name="date_deadline"/>
                <field name="parent_id"/>
                <field name="stage_id"/>
                <field name="user_ids"/>
                <field name="is_closed"/>
            </community_gantt>
        </field>
    </record>

    <record id="project.action_view_task" model="ir.actions.act_window">
        <field name="view_mode">kanban,list,form,calendar,pivot,graph,activity,community_gantt</field>
    </record>

    <record id="action_project_task_community_gantt" model="ir.actions.act_window">
        <field name="name">Project Gantt</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">community_gantt</field>
        <field name="view_id" ref="project_task_ara_community_gantt_view"/>
    </record>

    <menuitem
        id="menu_project_task_community_gantt"
        name="Gantt"
        parent="project.menu_main_pm"
        action="action_project_task_community_gantt"
        sequence="25"
        groups="project.group_project_user,project.group_project_manager"
    />
</odoo>